# Copie para .env e preencha. O .env nunca deve ir para o Git.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Sao_Paulo

# Supabase > Connect > Session pooler (porta 5432). Evite o Transaction pooler (6543).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Se trocar o modelo, a dimensão precisa continuar 1536 (ou ajuste a coluna embedding).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
